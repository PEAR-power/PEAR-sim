{
  "schema": "pear-sim/sensitivity-request/v0.1",
  "label": "Buck with loss cards: what moves output voltage and device losses",
  "method": "sobol",
  "parameters": [
    {"name": "duty", "from": "35 %", "to": "45 %"},
    {"name": "load", "from": "3 ohm", "to": "6 ohm"},
    {"name": "fsw", "from": "10 kHz", "to": "40 kHz", "scale": "log"}
  ],
  "outputs": [
    {"signal": "v(out)", "metric": "mean_last_half"},
    {"signal": "v(out)", "metric": "peak_to_peak_last_half"},
    {"losses": "total_mean_power_w"}
  ],
  "base_samples": 64,
  "seed": 1
}
