{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PEAR-power/pear-sim/main/schema/numerical-profile.schema.json",
  "title": "PEARSim numerical evidence profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "load_ratios",
    "point_count",
    "configuration_count",
    "cell_count",
    "studies",
    "configurations",
    "cross_platform_policy",
    "sha256"
  ],
  "properties": {
    "schema": {"const": "pear-sim/numerical-evidence-profile/v0.1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "load_ratios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "point_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "configuration_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "cell_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "studies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "studies",
          "solver",
          "rtol",
          "atol",
          "max_step_over_period",
          "output_step_over_period"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"},
          "studies": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "solver": {"enum": ["dopri5", "dop853", "radau", "bdf"]},
          "rtol": {"type": "number", "exclusiveMinimum": 0},
          "atol": {"type": "number", "exclusiveMinimum": 0},
          "max_step_over_period": {"type": "number", "exclusiveMinimum": 0},
          "output_step_over_period": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "cross_platform_policy": {"type": "object"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}
  }
}
