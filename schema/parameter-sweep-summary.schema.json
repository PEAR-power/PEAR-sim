{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PEAR-power/pear-sim/main/schema/parameter-sweep-summary.schema.json",
  "title": "PEARSim one-dimensional parameter-sweep summary v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "overall_status",
    "execution_status",
    "acceptance_status",
    "accepted",
    "parameter",
    "summary",
    "points",
    "expectations",
    "claim",
    "artifacts",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "pear-sim/parameter-sweep-summary/v0.1"},
    "kind": {"const": "one_dimensional_parameter_sweep"},
    "overall_status": {"$ref": "#/$defs/overallStatus"},
    "execution_status": {"$ref": "#/$defs/executionStatus"},
    "acceptance_status": {"$ref": "#/$defs/acceptanceStatus"},
    "accepted": {"type": ["boolean", "null"]},
    "parameter": {"$ref": "#/$defs/parameter"},
    "summary": {"$ref": "#/$defs/countSummary"},
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/pointSummary"}
    },
    "expectations": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/expectations"}
      ]
    },
    "claim": {"$ref": "#/$defs/claim"},
    "artifacts": {"$ref": "#/$defs/rootArtifacts"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "pathOnly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {"path": {"type": "string", "minLength": 1}}
    },
    "executionStatus": {"enum": ["pass", "fail"]},
    "acceptanceStatus": {
      "enum": ["pass", "fail", "not_run", "not_comparable", "not_applicable"]
    },
    "overallStatus": {
      "enum": ["pass", "fail", "not_run", "not_comparable", "not_applicable"]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dimension", "base_value_si"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dimension": {"type": "string", "minLength": 1},
        "base_value_si": {"type": "number"}
      }
    },
    "statusCounts": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "countSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_count",
        "execution_status_counts",
        "acceptance_status_counts",
        "overall_status_counts",
        "projection_selector_count",
        "projection_record_status_counts",
        "failure_count"
      ],
      "properties": {
        "point_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "execution_status_counts": {"$ref": "#/$defs/statusCounts"},
        "acceptance_status_counts": {"$ref": "#/$defs/statusCounts"},
        "overall_status_counts": {"$ref": "#/$defs/statusCounts"},
        "projection_selector_count": {"type": "integer", "minimum": 0, "maximum": 32},
        "projection_record_status_counts": {"$ref": "#/$defs/statusCounts"},
        "failure_count": {"type": "integer", "minimum": 0}
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "metric", "unit"],
      "properties": {
        "signal": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "unit": {"enum": ["V", "A"]}
      }
    },
    "projectionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "status", "value", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "selector": {"$ref": "#/$defs/selector"},
        "status": {"enum": ["recorded", "not_run"]},
        "value": {"type": ["number", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "runLink": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "run_sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "run_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "evidenceLink": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/pathOnly"}]
    },
    "pointArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point", "run", "evidence"],
      "properties": {
        "point": {"$ref": "#/$defs/artifact"},
        "run": {"$ref": "#/$defs/runLink"},
        "evidence": {"$ref": "#/$defs/evidenceLink"}
      }
    },
    "pointSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "point_id",
        "parameter_value_si",
        "execution_status",
        "acceptance_status",
        "accepted",
        "overall_status",
        "projections",
        "artifacts"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 63},
        "point_id": {"type": "string", "pattern": "^point-[0-9]{3}-[0-9a-f]{12}(?![\\s\\S])"},
        "parameter_value_si": {"type": "number"},
        "execution_status": {"$ref": "#/$defs/executionStatus"},
        "acceptance_status": {"$ref": "#/$defs/acceptanceStatus"},
        "accepted": {"type": ["boolean", "null"]},
        "overall_status": {"$ref": "#/$defs/overallStatus"},
        "projections": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/projectionRecord"}
        },
        "artifacts": {"$ref": "#/$defs/pointArtifacts"}
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "normalized", "semantic_sha256"],
      "properties": {
        "source": {"$ref": "#/$defs/artifact"},
        "normalized": {"$ref": "#/$defs/artifact"},
        "semantic_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "validation_claim",
        "compatibility_claim",
        "hardware_sign_off_allowed",
        "statement"
      ],
      "properties": {
        "classification": {"const": "agent_experiment"},
        "validation_claim": {"const": false},
        "compatibility_claim": {"const": false},
        "hardware_sign_off_allowed": {"const": false},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "rootArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_request",
        "normalized_request",
        "source_model",
        "projections",
        "failures",
        "confidence",
        "human_report",
        "artifact_manifest"
      ],
      "properties": {
        "source_request": {"$ref": "#/$defs/artifact"},
        "normalized_request": {"$ref": "#/$defs/artifact"},
        "source_model": {"$ref": "#/$defs/artifact"},
        "projections": {"$ref": "#/$defs/artifact"},
        "failures": {"$ref": "#/$defs/artifact"},
        "confidence": {"$ref": "#/$defs/pathOnly"},
        "human_report": {"$ref": "#/$defs/pathOnly"},
        "artifact_manifest": {"$ref": "#/$defs/pathOnly"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pear_sim_version",
        "source_model_hashes",
        "request_source_sha256",
        "request_semantic_sha256",
        "network_access",
        "point_order"
      ],
      "properties": {
        "pear_sim_version": {"type": "string", "minLength": 1},
        "source_model_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_sha256", "model_sha256", "request_sha256"],
          "properties": {
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "model_sha256": {"$ref": "#/$defs/sha256"},
            "request_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "request_source_sha256": {"$ref": "#/$defs/sha256"},
        "request_semantic_sha256": {"$ref": "#/$defs/sha256"},
        "network_access": {"const": false},
        "point_order": {"const": "request_input_order"}
      }
    }
  }
}
