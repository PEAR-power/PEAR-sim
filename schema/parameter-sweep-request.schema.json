{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PEAR-power/pear-sim/main/schema/parameter-sweep-request.schema.json",
  "title": "PEARSim one-dimensional parameter-sweep request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "parameter", "values"],
  "properties": {
    "schema": {"const": "pear-sim/parameter-sweep-request/v0.1"},
    "parameter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {"type": "number"},
          {"type": "string", "minLength": 1, "maxLength": 256}
        ]
      }
    },
    "projections": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/projection"}
    }
  },
  "$defs": {
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "signal", "metric", "unit"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*(?![\\s\\S])"
        },
        "signal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[vi]\\([A-Za-z_][A-Za-z0-9_.:-]*\\)(?![\\s\\S])"
        },
        "metric": {
          "enum": [
            "final",
            "max",
            "max_last_half",
            "mean",
            "mean_last_half",
            "min",
            "min_last_half",
            "peak_to_peak",
            "peak_to_peak_last_half",
            "ripple",
            "ripple_last_half",
            "rms",
            "rms_last_half",
            "sample_final",
            "sample_max",
            "sample_max_last_half",
            "sample_mean",
            "sample_mean_last_half",
            "sample_min",
            "sample_min_last_half",
            "sample_peak_to_peak",
            "sample_peak_to_peak_last_half",
            "sample_rms",
            "sample_rms_last_half"
          ]
        },
        "unit": {"enum": ["V", "A"]}
      }
    }
  }
}
